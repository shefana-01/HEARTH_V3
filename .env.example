# Settings for `docker compose up`. Copy this file to `.env` (next to docker-compose.yml) and change what
# you need. Everything has a working default, so the file is optional for trying Hearth on your computer.
# `.env` is in .gitignore: never commit real passwords.

# Password of the PostgreSQL user "hearth" (all six service databases).
DB_PASSWORD=change-me

# Password of the Neo4j user "neo4j" (the family map).
NEO4J_PASSWORD=change-me-too

# Where people open Hearth. Used for the links in emails (confirm email, reset password, invitations).
APP_URL=http://localhost:8000

# Web addresses allowed to call the API from a browser, comma-separated. Only needed for `npm run dev`
# (the Docker web app on port 8000 talks to the API through the same address).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# true: also show people the family-wide notifications about what they did themselves (handy when you
# test alone with one account). false in normal use.
NOTIFY_OWN_ACTIONS=false

# Port mapping for local development
API_GATEWAY_PORT=8080


# ───────── AI help (quick add, plan my week, message drafts) ─────────
# Free API key from https://aistudio.google.com/apikey (or any compatible endpoint). Leave empty to run
# Hearth in offline basic mode: everything still works without a key.
AI_API_KEY=
# The model used for every AI request.
AI_MODEL=gemini-2.5-flash
# Fair use: AI requests one person may make per day, and tokens one family may use per month.
AI_DAILY_REQUESTS=40
AI_MONTHLY_TOKENS=500000

# ───────── Push notifications (phones and computers, even with Hearth closed) ─────────
# Create the pair once with `node tools/vapid-keys.mjs` and paste both lines here. Without them push
# notifications are off; in-app notifications and live updates still work. Browsers only allow push on
# https:// addresses (and on http://localhost while developing).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A way for push services to contact whoever runs this Hearth.
VAPID_SUBJECT=mailto:admin@hearth.local

# ───────── Monitoring (docker-compose.monitoring.yml) ─────────
# Password of the Grafana "admin" user on http://localhost:3001.
GRAFANA_PASSWORD=change-me-three

# ───────── Production only (docker-compose.prod.yml) ─────────
# The public address Caddy serves (with an automatic Let's Encrypt certificate) and the address
# Let's Encrypt and push services can contact. DNS for the domain must point at this machine.
HEARTH_DOMAIN=
ACME_EMAIL=
# Your mail server for sign-up, invitations and password resets.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
